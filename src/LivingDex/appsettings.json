{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LivingDex": {
    "DataDirectory": "data",
    "AllowRegistration": true,
    "BehindProxy": false,
    "HistoryLimit": 200,
    "CacheAssets": true,
    "ShowdownEnabled": true,
    "TurnSeconds": 60,
    "NodePath": "node",
    "SimDirectory": "sim"
  }
}
