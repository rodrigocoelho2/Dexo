{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LivingDex": ""
  },
  "LivingDex": {
    "DataDirectory": "data",
    "AssetsDirectory": "assets",
    "AllowRegistration": true,
    "BehindProxy": false,
    "AuthAttemptsPerMinute": 10,
    "HistoryLimit": 200,
    "CacheAssets": true,
    "MaxStateBytes": 8388608,
    "ShowdownEnabled": true,
    "TurnSeconds": 60,
    "NodePath": "node",
    "SimDirectory": "Simulator"
  }
}
